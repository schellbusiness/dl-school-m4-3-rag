{
  "name": "dl-agentic-workshop",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:pdf": "python3 data/generate-handbook-pdf.py",
    "seed": "node seed/seed-handbook-vectors.mjs",
    "chunk": "node scripts/chunk-pdfs.mjs",
    "seed:mine": "WORKSHOP_CORPUS=data/my-corpus.json WORKSHOP_PINECONE_NAMESPACE=vanessa-docs node seed/seed-handbook-vectors.mjs",
    "visualize:vectors": "node vector-map/visualize-handbook-vectors.mjs",
    "example:handbook": "tsx example/rag/langchain-handbook-agent.ts",
    "example:rag": "tsx example/rag/langchain-handbook-agent.ts",
    "example:rag:deterministic": "tsx example/rag/deterministic-chain.ts",
    "rag:mine": "WORKSHOP_PINECONE_NAMESPACE=vanessa-docs tsx example/rag/my-deterministic-chain.ts",
    "eval:golden": "node scripts/eval-golden.mjs",
    "example:mcp": "tsx example/mcp/handbook-server.ts",
    "example:mcp:demo": "tsx example/mcp/handbook-demo-client.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^1.2.16",
    "@langchain/openai": "^1.6.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pinecone-database/pinecone": "^9.0.0",
    "openai": "^7.28.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "pdfjs-dist": "^5.7.284",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
